# Anthropic API 키 (필수) - https://platform.claude.com 에서 발급
ANTHROPIC_API_KEY=sk-ant-...

# 이미지 검색 API 키 (둘 중 하나 이상 필요)
# Pexels: https://www.pexels.com/api/  (무료)
PEXELS_API_KEY=
# Unsplash: https://unsplash.com/developers  (무료)
UNSPLASH_ACCESS_KEY=

# 네이버 블로그 아이디 (blog.naver.com/여기부분)
NAVER_BLOG_ID=

# 사용할 Claude 모델 (기본: claude-opus-4-8)
BLOG_MODEL=claude-opus-4-8

# Kimi (Moonshot AI) API 키 — 선택. Kimi K2 계열 모델을 쓰려면 필요.
# 발급: https://platform.moonshot.ai/console/api-keys
KIMI_API_KEY=
# 중국 리전 계정이면 아래로 교체 (기본은 국제 리전):
# KIMI_BASE_URL=https://api.moonshot.cn/v1

# Wikimedia 등 이미지 API의 User-Agent 연락처(선택)
CONTACT_EMAIL=
